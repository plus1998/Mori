#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Git exports the pushing repository's index/worktree variables to hooks.
# Clear them before tests create temporary repositories, otherwise those repos
# can accidentally read the current checkout's index.
unset GIT_DIR GIT_INDEX_FILE GIT_PREFIX GIT_WORK_TREE

echo "[pre-push] verifying the real terminal runtime..."
node apps/desktop/scripts/verify-terminal-runtime.mjs

echo "[pre-push] analyzing the mobile app..."
(cd apps/mobile && flutter pub get && flutter analyze)

echo "[pre-push] running the mobile test suite..."
node scripts/test.mjs --mobile

echo "[pre-push] type checking the desktop app..."
bunx tsc -b apps/desktop/tsconfig.json --pretty false
bunx tsc --noEmit -p apps/desktop/tsconfig.json

echo "[pre-push] running Supabase Edge Function tests with Deno..."
bun run test:supabase

echo "[pre-push] running the strict test gate..."
node scripts/test-gate.mjs --strict

echo "[pre-push] running the complete PI regression..."
node scripts/pi-regression.mjs
