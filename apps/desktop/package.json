{
  "name": "@eco/desktop",
  "version": "0.2.0-beta.7",
  "description": "Mori desktop app",
  "author": "Mori",
  "type": "module",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "dev:electron": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "smoke:browser-cli": "node scripts/browser-cli-direct-smoke.mjs",
    "smoke:tool-writing-state": "bun run scripts/smoke-tool-writing-state.ts",
    "smoke:tts-doubao": "bun run scripts/tts-doubao-smoke.ts",
    "smoke:packaged-pi": "node scripts/ensure-electron-binary.mjs && electron scripts/verify-packaged-pi-runtime.mjs --search release",
    "smoke:cdp-probe": "node scripts/dev-cdp-ui-probe.mjs",
    "smoke:cdp-center": "node scripts/dev-cdp-center-server-smoke.mjs",
    "smoke:cdp-terminal-copy": "node scripts/dev-cdp-terminal-copy-probe.mjs",
    "smoke:cdp-demo": "node scripts/dev-cdp-ui-demo.mjs",
    "playwright-cli": "playwright cli",
    "cdp:attach": "playwright cli attach --cdp=http://127.0.0.1:9333",
    "cdp:snap": "playwright cli snapshot",
    "cdp:click": "playwright cli click",
    "cdp:fill": "playwright cli fill",
    "cdp:shot": "playwright cli screenshot",
    "build": "vite build && bun run build:main && bun run build:preload",
    "build:main": "bun build src/main/index.ts --target=node --external electron --external electron-updater --external @anthropic-ai/claude-agent-sdk --external node-pty --external @napi-rs/keyring --external koffi --external @earendil-works/pi-coding-agent --external @earendil-works/pi-mcp --outdir dist/main && node scripts/verify-main-bundle.mjs",
    "build:demo-main": "bun build src/main/demo.ts --target=node --external electron --outdir dist/demo-main",
    "build:preload": "bun build src/preload/index.ts --target=node --format=cjs --external electron --outfile dist/preload/index.cjs",
    "feed:parity": "bun scripts/feed-skeleton-parity-audit.mjs",
    "feed:replay": "bun scripts/feed-replay.ts",
    "conversation:v2-migrate": "bun scripts/conversation-v2-migrate.ts",
    "conversation:v2-correct-run": "bun scripts/conversation-v2-correct-run.ts",
    "conversation:v2-repair-event-hash": "bun build scripts/conversation-v2-repair-event-hash.ts --target=node --outfile .tmp/conversation-v2-repair-event-hash.mjs && node .tmp/conversation-v2-repair-event-hash.mjs",
    "conversation:v2-benchmark": "bun scripts/conversation-v2-benchmark.ts",
    "test:release": "bun test test/desktop-update-policy.test.ts test/desktop-update-service.test.ts test/desktop-update-banner-state.test.ts test/release-repository.test.ts test/after-pack-mac-sign.test.ts test/prepare-node-pty.test.ts test/pack-builder-args.test.ts",
    "typecheck:release": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --esModuleInterop --skipLibCheck --types node src/shared/desktop-update.ts src/main/desktop-update-policy.ts src/main/desktop-update-service.ts src/renderer/desktop-update-banner-state.ts",
    "postinstall": "node scripts/rebuild-native.mjs",
    "icons": "bun scripts/generate-icons.mjs",
    "pack": "bun run build && node scripts/prepare-agent-browser.mjs && node scripts/prepare-open-computer-use.mjs && node scripts/write-release-manifest.mjs && node scripts/pack-local.mjs",
    "pack:mac-arm64": "bun run build && node scripts/prepare-agent-browser.mjs && node scripts/prepare-open-computer-use.mjs && node scripts/write-release-manifest.mjs && node scripts/pack-release.mjs --mac dmg zip --arm64",
    "update:mac-arm64": "node scripts/update-mac-arm64.mjs",
    "pack:mac-x64": "bun run build && node scripts/prepare-agent-browser.mjs && node scripts/prepare-open-computer-use.mjs && node scripts/write-release-manifest.mjs && node scripts/pack-release.mjs --mac dmg zip --x64",
    "pack:win-x64": "bun run build && node scripts/prepare-agent-browser.mjs && node scripts/prepare-open-computer-use.mjs && node scripts/write-release-manifest.mjs && node scripts/pack-release.mjs --win nsis --x64",
    "pack:linux-x64": "bun run build && node scripts/prepare-agent-browser.mjs && node scripts/prepare-open-computer-use.mjs && node scripts/write-release-manifest.mjs && node scripts/pack-release.mjs --linux AppImage --x64",
    "readme:screenshots": "node readme-screenshots/capture.mjs",
    "readme:screenshots:demo": "node scripts/capture-demo-readme.mjs",
    "readme:screenshots:preview": "bunx vite --config readme-screenshots/vite.config.ts --host 127.0.0.1 --port 5199"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@eco/gateway": "workspace:*",
    "@eco/openai-anthropic-bridge": "workspace:*",
    "@eco/shared": "workspace:*",
    "@lezer/common": "^1.5.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "@noble/hashes": "2.0.0",
    "@openai/codex": "0.163.0",
    "@qwen-code/open-computer-use": "0.2.3",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-virtual": "3.14.13",
    "@uiw/react-codemirror": "^4.25.11",
    "agent-browser": "0.33.2",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.38.0",
    "electron-updater": "6.8.9",
    "fix-path": "^5.0.0",
    "ghostty-web": "^0.4.0",
    "gitdiff-parser": "^0.3.1",
    "http-proxy-to-socks": "^1.1.4",
    "i18next": "^25.3.2",
    "jose": "^6.2.3",
    "koffi": "^3.2.1",
    "markdown-it": "^15.0.0",
    "markdown-it-cjk-friendly": "3.0.0",
    "material-icon-theme": "5.37.0",
    "mermaid": "^11.17.2",
    "node-pty": "^1.0.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "pinyin-pro": "^3.29.5",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "react-i18next": "^15.6.1",
    "shiki": "^4.4.2",
    "socks": "^2.8.10",
    "socks-proxy-agent": "^10.1.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.301",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.301",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.301",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.301",
    "@openai/codex-darwin-arm64": "npm:@openai/codex@0.163.0-darwin-arm64",
    "@openai/codex-darwin-x64": "npm:@openai/codex@0.163.0-darwin-x64",
    "@openai/codex-linux-arm64": "npm:@openai/codex@0.163.0-linux-arm64",
    "@openai/codex-linux-x64": "npm:@openai/codex@0.163.0-linux-x64",
    "@openai/codex-win32-arm64": "npm:@openai/codex@0.163.0-win32-arm64",
    "@openai/codex-win32-x64": "npm:@openai/codex@0.163.0-win32-x64"
  },
  "devDependencies": {
    "@eco/model-router": "workspace:*",
    "@eco/runtime": "workspace:*",
    "@eco/workspace": "workspace:*",
    "@electron/rebuild": "^4.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/qrcode.react": "^3.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "@playwright/test": "^1.61.1",
    "qrcode.react": "^4.2.0",
    "rcedit": "^4.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "^7.0.0",
    "zustand": "^5.0.0",
    "@types/papaparse": "^5.5.2"
  }
}
